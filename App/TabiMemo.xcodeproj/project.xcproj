{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "ja",
    "supported": [
      "en",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "Domain",
    }, {
      "kind": "local",
      "path": "DataLayer",
    }, {
      "kind": "local",
      "path": "Features",
    }, {
      "kind": "remote",
      "repository": "https://github.com/SimplyDanny/SwiftLintPlugins",
      "version": {
        "version": "0.65.1",
      },
    },
  ],
  "files": [
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/TabiMemo.app", "id": "8962741C8A4DF8A827949B3A", "type": "wrapper.application", "index": false },
      ],
    },
    { "kind": "folder", "path": "TabiMemo/Sources", "target-membership": [ "TabiMemo" ] },
    { "path": "TabiMemo/Info.plist" },
    { "path": ".swiftlint.yml" },
  ],
  "targets": [
    {
      "name": "TabiMemo",
      "id": "2C5E99AB7B39C2206E8A3DE4",
      "product": "Products/TabiMemo.app",
      "product-type": "application",
      "dependencies": [
        { "kind": "package", "product-name": "SwiftLintBuildToolPlugin", "product-type": "build-tool-plugin" },
        { "kind": "package", "package": "Domain", "product-name": "Domain" },
        { "kind": "package", "package": "DataLayer", "product-name": "DataLayer" },
        { "kind": "package", "package": "Features", "product-name": "TripMapFeature" },
        { "kind": "package", "package": "Features", "product-name": "PhotoListFeature" },
        { "kind": "package", "package": "Features", "product-name": "AddPhotosFeature" },
        { "kind": "package", "package": "Features", "product-name": "EditPhotoFeature" },
        { "kind": "package", "package": "Features", "product-name": "RecentlyDeletedFeature" },
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "package": "DataLayer",
          "product-name": "DataLayer",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Domain",
          "product-name": "Domain",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Features",
          "product-name": "AddPhotosFeature",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Features",
          "product-name": "EditPhotoFeature",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Features",
          "product-name": "PhotoListFeature",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Features",
          "product-name": "RecentlyDeletedFeature",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Features",
          "product-name": "TripMapFeature",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ENABLE_PREVIEWS": "YES",
        "INFOPLIST_FILE": "TabiMemo/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.akidon0000.tabimemo",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CODE_SIGN_IDENTITY": "iPhone Developer",
    "COPY_PHASE_STRIP": "NO",
    "CURRENT_PROJECT_VERSION": "1",
    "DEAD_CODE_STRIPPING": "YES",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "XSC9AJPSP3",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
    "LD_RUNPATH_SEARCH_PATHS": [
      "$(inherited)",
      "@executable_path/Frameworks",
      "@loader_path/Frameworks",
    ],
    "MARKETING_VERSION": "1.0",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "PRODUCT_NAME": "$(TARGET_NAME)",
    "SDKROOT": "iphoneos",
    "SUPPORTS_MACCATALYST": "NO",
    "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
    "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "$(inherited) DEBUG",
    "SWIFT_COMPILATION_MODE[config=Debug]": "singlefile",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "SWIFT_STRICT_CONCURRENCY": "complete",
    "SWIFT_VERSION": "6.0",
    "TARGETED_DEVICE_FAMILY": "1,2",
    "VALIDATE_PRODUCT[config=Release]": "YES",
  },
}
